{
  "name": "liandre-bootstrap-sass-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Single-page portfolio rebuilt with Bootstrap utilities/components and Sass variable overrides.",
  "scripts": {
    "build:css": "sass --load-path=node_modules src/scss/main.scss assets/css/main.css --style=compressed --no-source-map",
    "watch:css": "sass --load-path=node_modules --watch src/scss/main.scss:assets/css/main.css"
  },
  "dependencies": {
    "bootstrap": "5.3.8"
  },
  "devDependencies": {
    "sass": "1.103.1"
  }
}
